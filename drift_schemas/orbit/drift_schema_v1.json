    {
      "name": "areas",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"areas\" (\"id\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"deleted_at\" TEXT NULL, \"name\" TEXT NOT NULL, \"color\" TEXT NOT NULL, \"sort_order\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "objectives",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"objectives\" (\"id\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"deleted_at\" TEXT NULL, \"title\" TEXT NOT NULL, \"description\" TEXT NOT NULL DEFAULT '', \"start_date\" TEXT NOT NULL, \"end_date\" TEXT NOT NULL, \"status\" TEXT NOT NULL, \"sort_order\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "key_results",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"key_results\" (\"id\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"deleted_at\" TEXT NULL, \"objective_id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"description\" TEXT NOT NULL DEFAULT '', \"measure_type\" TEXT NOT NULL, \"start_value\" REAL NULL, \"target_value\" REAL NULL, \"current_value\" REAL NULL, \"unit\" TEXT NULL, \"habit_id\" TEXT NULL, \"deadline\" TEXT NULL, \"sort_order\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "projects",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"projects\" (\"id\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"deleted_at\" TEXT NULL, \"title\" TEXT NOT NULL, \"description\" TEXT NOT NULL DEFAULT '', \"area_id\" TEXT NULL, \"key_result_id\" TEXT NULL, \"status\" TEXT NOT NULL, \"importance\" INTEGER NOT NULL CHECK(\"importance\" BETWEEN 1 AND 5), \"deadline\" TEXT NULL, \"next_step_task_id\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "tasks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"tasks\" (\"id\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"deleted_at\" TEXT NULL, \"project_id\" TEXT NULL, \"title\" TEXT NOT NULL, \"notes\" TEXT NOT NULL DEFAULT '', \"due_date\" TEXT NULL, \"status\" TEXT NOT NULL, \"completed_at\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "habits",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"habits\" (\"id\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"deleted_at\" TEXT NULL, \"title\" TEXT NOT NULL, \"project_id\" TEXT NULL, \"key_result_id\" TEXT NULL, \"schedule_type\" TEXT NOT NULL, \"weekdays\" TEXT NULL, \"times_per_week\" INTEGER NULL, \"reminder_time\" TEXT NULL, \"active\" INTEGER NOT NULL DEFAULT 1 CHECK (\"active\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "habit_checks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"habit_checks\" (\"id\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"deleted_at\" TEXT NULL, \"habit_id\" TEXT NOT NULL, \"date\" TEXT NOT NULL, \"log_entry_id\" TEXT NULL, PRIMARY KEY (\"id\"), UNIQUE (\"habit_id\", \"date\"));"
        }
      ]
    },
    {
