        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"log_entries\" (\"id\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"deleted_at\" TEXT NULL, \"project_id\" TEXT NULL, \"key_result_id\" TEXT NULL, \"occurred_at\" TEXT NOT NULL, \"duration_minutes\" INTEGER NULL, \"note\" TEXT NOT NULL DEFAULT '', \"source\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
