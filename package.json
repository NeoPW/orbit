{
  "name": "orbit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "check": "npm run typecheck && npm run lint && npm run test",
    "tauri": "tauri",
    "desktop": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "desktop:build": "tauri build",
    "android": "sh scripts/android.sh dev",
    "android:build": "sh scripts/android.sh build --debug --apk",
    "server:dev": "npm run build && wrangler d1 migrations apply orbit --local -c server/wrangler.jsonc && wrangler dev -c server/wrangler.jsonc",
    "server:migrate": "wrangler d1 migrations apply orbit --remote -c server/wrangler.jsonc",
    "server:deploy": "npm run build && npm run server:migrate && wrangler deploy -c server/wrangler.jsonc",
    "server:token": "node -e \"console.log(require('crypto').randomBytes(32).toString('base64url'))\"",
    "server:smoke": "node server/smoke.mjs",
    "db:generate": "drizzle-kit generate",
    "db:generate:server": "drizzle-kit generate --config drizzle.server.config.ts",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "^3.54.1-build1",
    "@tauri-apps/api": "^2.12.4",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.69.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
